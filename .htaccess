# Tenerife Compass — cache-stýring & tidy URLs
#
# Segjum SiteGround (og öðrum proxy/cache-lögum) að GEYMA EKKI HTML.
# Þá birtast breytingar strax eftir deploy. Static eignir eru cache-uð lengi.

<IfModule mod_headers.c>
  # HTML-skrár: aldrei cache-a (svo efnisbreytingar sjáist strax)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Static eignir: cache-a lengi
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ein rétt útgáfa af hverri slóð: https og án www.
  # (canonical-taggarnir okkar segja https://tenerifecompass.com/ — þetta lætur
  #  vefþjóninn segja það sama, svo Google dreifi ekki trausti á 4 útgáfur.)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://tenerifecompass.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Snyrtileg vefföng: /where-to-stay virkar án .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Sérsniðnar villusíður
ErrorDocument 404 /404.html
